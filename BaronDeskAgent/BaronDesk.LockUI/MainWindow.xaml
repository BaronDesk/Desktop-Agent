<Window x:Class="BaronDesk.LockUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BaronDesk" WindowStyle="None" WindowState="Maximized"
        Topmost="True" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="Black">
    <Grid>
        <TextBlock Text="Station locked — scan your card or log in to play"
                   Foreground="White" FontSize="28"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- TEMPORARY test controls — remove before final submission -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,60">
            <Button Content="TEST: Call ShowLockScreen" Click="TestShow_Click" Margin="5" Padding="10,5"/>
        </StackPanel>

        <Button Content="STOP (test only)" Click="TestForceHide_Click"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="10,5"/>
    </Grid>
</Window>