<Window x:Class="BaronDesk.LockUI.NoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BaronDesk notice" WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        SizeToContent="WidthAndHeight"
        Background="#161A22" BorderThickness="2" BorderBrush="#F59E0B">
    <!-- In-session notice: a small corner box that never takes focus from the game. -->
    <StackPanel Margin="16,12" Width="320">
        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold" Foreground="#F59E0B" />
        <TextBlock x:Name="BodyText" FontSize="13" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,4,0,0" />
        <TextBlock x:Name="CountdownText" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,6,0,0" />
    </StackPanel>
</Window>
