<Window x:Class="BaronDesk.LockUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BaronDesk" WindowStyle="None" WindowState="Normal"
        Topmost="True" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#0D0F12"
        Loaded="OnLoaded">
    <Grid>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#161A22" CornerRadius="12" Padding="40,36"
                BorderBrush="#2A303C" BorderThickness="1"
                MaxWidth="500" Width="440">
            <StackPanel HorizontalAlignment="Stretch">
                <!-- Visible only in the Debug-only windowed test mode (started with the "windowed" argument). -->
                <TextBlock x:Name="TestModeBanner" Visibility="Collapsed"
                           FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,0,0,16" />

                <TextBlock Text="BARONDESK"
                           Foreground="#00D2FF" FontSize="26" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,12" />

                <TextBlock Text="Station locked — enter your booking PIN to play"
                           Foreground="#E2E8F0" FontSize="15" TextWrapping="Wrap"
                           TextAlignment="Center" HorizontalAlignment="Center"
                           Margin="0,0,0,24" />

                <TextBlock Text="BOOKING PIN"
                           Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"
                           Margin="0,0,0,6" />

                <PasswordBox x:Name="PinBox"
                             FontSize="18" Padding="12,8" Margin="0,0,0,14"
                             Background="#0F1218" Foreground="#F8FAFC"
                             BorderBrush="#334155" BorderThickness="1"
                             HorizontalContentAlignment="Center"
                             MaxLength="64"
                             KeyDown="OnPinKeyDown" />

                <Button x:Name="UnlockButton" Content="Unlock Station"
                        Background="#0284C7" Foreground="White"
                        FontWeight="SemiBold" FontSize="14"
                        Padding="0,10" Cursor="Hand"
                        Click="OnUnlockClick" Margin="0,0,0,12" />

                <TextBlock x:Name="StatusText" Text=""
                           Foreground="#94A3B8" FontSize="13" TextWrapping="Wrap"
                           TextAlignment="Center" HorizontalAlignment="Center"
                           MinHeight="20" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
